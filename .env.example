# ---- NEVER commit the real .env. Generate secrets with: openssl rand -hex 48 ----

# MongoDB
MONGO_ROOT_USER=rootadmin
MONGO_ROOT_PASSWORD=change_me_long_random
MONGO_DB=soc_portfolio
MONGO_APP_USER=portfolio_app
MONGO_APP_PASSWORD=change_me_long_random
# Optional Atlas connection string. Leave empty to use the local MongoDB service.
# Keep credentials in the ignored .env file; URL-encode special characters in passwords.
MONGO_URI=

# Redis
REDIS_PASSWORD=change_me_long_random
TRUST_PROXY_HOPS=0

# Auth (use three DIFFERENT random values)
JWT_ACCESS_SECRET=change_me_openssl_rand_hex_48
JWT_REFRESH_SECRET=change_me_openssl_rand_hex_48
CSRF_SECRET=change_me_openssl_rand_hex_48

# Web
CORS_ORIGINS=https://my-portfolio-m3bc-i25ems9w5-sandip-80b8.vercel.app
COOKIE_DOMAIN=
PUBLIC_SITE_URL=https://my-portfolio-m3bc-i25ems9w5-sandip-80b8.vercel.app

# GitHub integration (fine-grained token, public_repo read-only; optional but avoids rate limits)
GITHUB_USERNAME=Sandip-Sec0922
GITHUB_TOKEN=

# Cloudflare Turnstile (optional, free)
TURNSTILE_SECRET=

# SMTP is optional for contact notifications but required for admin password recovery.
